# ⚠️ SECURITY: only prefix a variable with NEXT_PUBLIC_ if it is safe to be
# visible in the browser (e.g. via View Source / DevTools). Never add that
# prefix to a secret key — anything without it stays server-only.
# This file itself only holds placeholder names, never real values — the
# real values go in .env.local, which is gitignored and must never be committed.

# ---- Supabase ----
# From your Supabase project: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-side only, never expose to the browser or commit a real value
SUPABASE_SERVICE_ROLE_KEY=
